# Server configuration
PORT=3005

# Public Webhook URL (e.g., your ngrok, cloudflare tunnel, or domain)
# Example: https://your-subdomain.ngrok-free.app
WEBHOOK_URL=http://localhost:3005

# Meta WhatsApp Cloud API credentials
# Get these from https://developers.facebook.com/
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=my-secret-verify-token
WHATSAPP_ACCESS_TOKEN=

# AI Provider API Key (Optional: Puter.js, Google Gemini or OpenAI)
# Puter.js provides free access to OpenAI models (gpt-5.4-nano, gpt-4o-mini, etc.)
PUTER_AUTH_TOKEN=
PUTER_MODEL=gpt-5.4-nano
GEMINI_API_KEY=
OPENAI_API_KEY=
